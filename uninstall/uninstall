#!/bin/bash
# ACTi Kamera - Deinstallation
#
# LoxBerry fuehrt NUR diese Datei aus: plugininstall.pl sucht
# uninstall/uninstall* (Geraet/2026-09-05/08_plugininstall.pl:1152), kopiert
# sie nach data/system/uninstall/<ordner> und ruft sie mit "$tempfile"
# "$pname" "$pfolder" "$pversion" "$lbhomedir" "$tempfolder" auf (Regeln/06,
# Abschnitt "Deinstallation", am Geraet nachgesehen am 17.09.2026,
# LoxBerry 4.0.0.15). Bis 1.9.22 lag daneben eine byteweise gleiche uninstall.sh an der
# Archivwurzel, mit dem Satz, ob sie je laufe, sei nicht gemessen. Das ist
# durch den Installer-Quelltext beantwortet: sie wurde weder kopiert noch
# ausgefuehrt (Pruefung 29.09.2026, Befund I8). Sie ist seit 1.9.23 entfernt.
# Argumente: $3 Ordnername, $5 Wurzel.
#
# LoxBerry entfernt bei der Deinstallation nur die VERZEICHNISSE des Plugins.
# Die Zweitschrift liegt eine Ebene darueber - genau deshalb ueberlebt sie ein
# Update - und bliebe sonst liegen. Sie enthaelt Benutzername und
# Klartextpasswort der Kamera, gegebenenfalls dazu die vollstaendige
# Schnappschuss-URL mit PWD=.
#
# Ueberschreiben vor dem Loeschen: ein blankes rm laesst den Inhalt auf der
# Karte stehen.
#
# Angefasst wird ausschliesslich die eigene Datei. Ein pauschales rm -rf auf
# das Konfigurationsverzeichnis traefe alle Plugins.
#
# Uninstall-Praefix (A7/E1, seit 1.9.32; am Geraet gemessen 08.10.2026,
# plugininstall.pl :1570/:1603): beim Deinstallieren ruft der Installer JEDES
# data/system/uninstall/<name>* - auch dieses Skript, wenn ein Plugin
# deinstalliert wird, dessen NAME ein Praefix von "actikamera" ist; $2 ist dann
# DESSEN Name. Dann gehoert der Lauf nicht uns: nichts tun. Bis 1.9.31 haette
# das die Zweitschrift dieser Anlage geloescht (Befund E1). Bauart Ferien
# 1.2.29 / APC-UPS NG 1.2.24.
if [ -n "${2:-}" ] && [ "${2:-}" != "actikamera" ] && [ "${2:-}" != "$(basename "$0")" ]; then
    echo "<INFO> ACTi Kamera: aufgerufen fuer das Plugin '${2:-}', nicht fuer actikamera - nichts angefasst."
    exit 0
fi
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-actikamera}"
BASE="${ARGV5:-$LBHOMEDIR}"
case "$PFOLDER" in
    ''|*/*|.|..) echo "<FAIL> Unzulaessiger Ordnername '$PFOLDER' - nichts geloescht."; exit 1 ;;
esac
# Die LoxBerry-Wurzel. Der Installer uebergibt sie als fuenftes Argument;
# $LBHOMEDIR gilt nur mit config/plugins UND data/plugins darunter. Sonst wird
# vom eigenen Ablageort aufwaerts gesucht, und Wurzel ist nur, was
# config/plugins, data/plugins UND config/system/general.json traegt
# (Regeln/06). Ohne Wurzel wird gewarnt und nichts getan.
#
# Bis 1.9.21 stand hier nur BASE="${ARGV5:-$LBHOMEDIR}": fehlten beide, lagen
# alle Pfade ab / - in einem Wurzelbaum mit Schreibrecht legte preupgrade.sh
# /data/plugins/<ordner>.upgrade_laeuft an, postinstall.sh
# /data/plugins/<ordner>.archiv, postupgrade.sh /log/plugins/<ordner>, und die
# Deinstallation loeschte /config/plugins/<ordner>.backup.json (in WSL
# gemessen, Pruefung-ACTiKamera-1.9.22, Faelle W1-W5).
ac_wurzel_suchen() {
    ac_v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    ac_i=0
    while [ -n "$ac_v" ] && [ "$ac_v" != "/" ] && [ $ac_i -lt 8 ]; do
        if [ -d "$ac_v/config/plugins" ] && [ -d "$ac_v/data/plugins" ] \
           && [ -f "$ac_v/config/system/general.json" ]; then
            echo "$ac_v"; return 0
        fi
        ac_v=$(dirname "$ac_v"); ac_i=$((ac_i + 1))
    done
    return 1
}
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ]; then
    BASE=$(ac_wurzel_suchen) || BASE=""
fi
if [ -z "$BASE" ]; then
    echo "<WARNING> Es wurde kein LoxBerry-Wurzelverzeichnis gefunden: weder als"
    echo "<WARNING> fuenftes Argument noch in \$LBHOMEDIR, und oberhalb dieses Skripts"
    echo "<WARNING> traegt kein Verzeichnis config/plugins, data/plugins und"
    echo "<WARNING> config/system/general.json. Es wurde nichts entfernt."
    echo "<WARNING> Liegen bleiben kann config/plugins/$PFOLDER.backup.json mit den Zugangsdaten der Kamera."
    exit 1
fi

# Die zurueckbehaltenen MQTT-Themen der Linie (Regeln/07, Abschnitt 3: die
# Deinstallation raeumt sie ab). Bis 1.9.21 blieben BILDER, CLIPS, PERSON,
# zeit und die uebrigen Zustaende - und OK, ERREICHBAR, FEHLER, PUSHAKTIV,
# PTEST aus 1.9.19 bis 1.9.21 - nach dem Entfernen fuer immer im Broker und
# kamen nach jedem Neustart von Broker oder Gateway wieder am Miniserver an
# (Faelle U1-U6). Geloescht wird ueber den UDP-Eingang des Gateways, der
# nichts bestaetigt; cam_mqtt_leeren() fragt deshalb vorher und nach jeder
# Runde den Broker (hoechstens drei Runden). VOR dem Loeschen der Ordner,
# denn Praefix und Port stehen in der Konfiguration.
# Seit 1.9.32 (A7): als loxberry, wenn dieses Skript als root laeuft (es
# liest und sendet nur), und hoechstens 120 s - bis 1.9.31 lief es als root und
# ohne Frist (Bauart Marstek 1.1.28).
#
# Davor die Befehlsbruecke (seit 1.9.32, E-E5; Bauart Ferien 1.2.29): anhalten
# (stop beendet Dienst und mosquitto_sub, auch ein verwaistes), argumentweise
# nachzaehlen, die Optionsdateien mit dem Broker-Kennwort ueberschreiben und
# den Ordner befehle/ entfernen. Im Broker bleibt nichts: Quittungen und
# status/befehle sind nie zurueckbehalten.
BBSH="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.sh"
BBPHP="$BASE/bin/plugins/$PFOLDER/befehlsbruecke.php"
BBDIR="$BASE/data/plugins/$PFOLDER/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop
fi
BB_REST=0
for d in /proc/[0-9]*; do
    mapfile -d '' -t a 2>/dev/null < "$d/cmdline" || continue
    if [ "${#a[@]}" -eq 2 ] && [ "${a[1]}" = "$BBPHP" ] && [[ "${a[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${d#/proc/}" 2>/dev/null
        BB_REST=$((BB_REST + 1))
    fi
done
BB_ABOS=0
for d in /proc/[0-9]*; do
    read -r c 2>/dev/null < "$d/comm" || continue
    [ "$c" = "mosquitto_sub" ] || continue
    mapfile -d '' -t e 2>/dev/null < "$d/environ" || continue
    for x in "${e[@]}"; do
        if [ "$x" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${d#/proc/}" 2>/dev/null; BB_ABOS=$((BB_ABOS + 1)); fi
    done
done
[ "$BB_REST" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_REST Dienst(e) erst mit kill -9 beendet."
[ "$BB_ABOS" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $BB_ABOS mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$f" ]; then
            n=$(stat -c %s "$f" 2>/dev/null || echo 64)
            head -c "$n" /dev/zero > "$f" 2>/dev/null
        fi
    done
    rm -rf "${BBDIR:?}"
fi
if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
    echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
elif [ -f "$BBSH" ]; then
    echo "<OK> Befehlsbruecke angehalten, ihre Zugangsdaten entfernt."
fi

LAUF="$BASE/bin/plugins/$PFOLDER/cam_cron.php"
if [ -f "$LAUF" ] && command -v php >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout -k 5 120 php "$LAUF" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout -k 5 120 php "$LAUF" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> cam_cron.php oder php fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

BK="$BASE/config/plugins/$PFOLDER.backup.json"
if [ -f "$BK" ]; then
    : > "$BK"
    rm -f "$BK"
    if [ -e "$BK" ]; then
        echo "<WARNING> Die Zweitschrift $BK liess sich nicht entfernen."
    else
        echo "<OK> Zweitschrift mit den Zugangsdaten entfernt."
    fi
fi

# Weitere Kopien mit Kamerapasswort (Befunde I3 und I1, Pruefung 29.09.2026):
#   <ordner>.backup.json.alt            beiseitegelegt von preinstall.sh
#                                       (Rueckfall postinstall.sh)
#   config/plugins/<ordner>/cam.json.alt  im Takt geheilte cam.json, von
#                                       postinstall.sh beiseitegelegt (X-1)
#   <ordner>.upgrade_sicherung(.alt)/   cam.json einer Aktualisierung, die nicht
#                                       ankam, oder beiseitegelegt
#   config/plugins/<ordner>/cam.json.kaputt*  verdraengte Staende (0600)
# Bis 1.9.22 blieb die Upgrade-Sicherung samt Klartextkennwort nach der
# Deinstallation liegen, und das Protokoll meldete "Zugangsdaten entfernt"
# (in WSL gemessen, Fall F6). Jede Datei wird vor dem Loeschen ueberschrieben;
# gemeldet wird <OK> erst, wenn nachgezaehlt nichts mehr liegt. Die
# .alt-Betriebsdateien im Archivordner gehen mit, die Aufnahmen bleiben.
ac_weg() { # $1 Datei oder Verzeichnis
    if [ -d "$1" ] && [ ! -L "$1" ]; then
        for AC_F in "$1"/* "$1"/.[!.]*; do
            if [ -f "$AC_F" ] && [ ! -L "$AC_F" ]; then : > "$AC_F" 2>/dev/null; fi
        done
        case "$1" in
            */data/plugins/?*.upgrade_sicherung|*/data/plugins/?*.upgrade_sicherung.alt) rm -rf "$1" 2>/dev/null ;;
        esac
    else
        if [ -f "$1" ] && [ ! -L "$1" ]; then : > "$1" 2>/dev/null; fi
        rm -f "$1" 2>/dev/null
    fi
}
AC_WEG=""
AC_REST=""
ac_pruef_weg() { # $1 Pfad: weg, dann nachzaehlen
    if [ -e "$1" ] || [ -L "$1" ]; then
        ac_weg "$1"
        if [ -e "$1" ] || [ -L "$1" ]; then AC_REST="$AC_REST $1"; else AC_WEG="$AC_WEG $1"; fi
    fi
}
ac_pruef_weg "$BK.alt"
ac_pruef_weg "$BASE/data/plugins/$PFOLDER.upgrade_sicherung"
ac_pruef_weg "$BASE/data/plugins/$PFOLDER.upgrade_sicherung.alt"
for AC_P in "$BASE/config/plugins/$PFOLDER/cam.json.kaputt"* "$BASE/config/plugins/$PFOLDER/cam.json.alt" \
            "$BASE/data/plugins/$PFOLDER.archiv/"*.alt; do
    ac_pruef_weg "$AC_P"
done
if [ -n "$AC_REST" ]; then
    echo "<WARNING> Nicht entfernt (kann das Kamerapasswort tragen), bitte von Hand loeschen:$AC_REST"
elif [ -n "$AC_WEG" ]; then
    echo "<OK> Upgrade-Sicherung und beiseitegelegte Staende entfernt, nachgezaehlt liegt nichts mehr da:$AC_WEG"
fi

# Der Merker einer abgebrochenen Neuinstallation (preinstall.sh legt ihn an,
# postinstall.sh entfernt ihn; X-1, B-Nachzug 01.10.2026). Er traegt nur eine
# Uhrzeit.
rm -f "$BASE/data/plugins/$PFOLDER.neuinstallation" 2>/dev/null
# Die Marke "Aktualisierung laeuft" aus preupgrade.sh liegt NEBEN dem
# Datenordner und uebersteht deshalb auch das Deinstallieren. Bliebe sie nach
# einer abgebrochenen Aktualisierung liegen, speicherte eine Neuinstallation
# innerhalb der naechsten Stunde nichts und der Minutentakt liefe nicht.
MARKE="$BASE/data/plugins/$PFOLDER.upgrade_laeuft"
if [ -f "$MARKE" ]; then
    rm -f "$MARKE" 2>/dev/null
    if [ -e "$MARKE" ]; then
        echo "<WARNING> Die Marke $MARKE liess sich nicht entfernen."
    else
        echo "<OK> Die Marke der Aktualisierung entfernt."
    fi
fi

# Die Aufnahmen bleiben absichtlich stehen. Sie sind der einzige Teil, den der
# Anwender nicht wiederherstellen kann, und eine Deinstallation ist kein
# Auftrag, Bildmaterial zu vernichten.
DATA="$BASE/data/plugins/$PFOLDER.archiv"
if [ -d "$DATA" ]; then
    echo "<INFO> Die Aufnahmen unter $DATA bleiben erhalten und koennen von Hand geloescht werden."
fi
# Der Zwischenspeicher /tmp/<ordner> (Merker ptest, letzte<n>.txt,
# mqtt_letzte.json, Sperren; seit 1.9.32 aus dem Ordnernamen, A8). $PFOLDER
# hat die Wache oben bestanden (kein Schraegstrich, nicht leer, nicht . oder ..).
if [ -d "/tmp/$PFOLDER" ] && [ ! -L "/tmp/$PFOLDER" ]; then
    rm -rf "/tmp/${PFOLDER:?}" 2>/dev/null
    if [ -e "/tmp/$PFOLDER" ]; then
        echo "<WARNING> Der Zwischenspeicher /tmp/$PFOLDER liess sich nicht entfernen."
    else
        echo "<OK> Zwischenspeicher /tmp/$PFOLDER entfernt."
    fi
fi
exit 0
